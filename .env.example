# Google Maps (client / public) — Places Autocomplete on the scan-event admin form
# and the public "Where to scan" map. Create in Google Cloud Console with the
# Maps JavaScript API + Places API (New) enabled and billing turned on.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Firebase (client / public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Resend (server) — sending domain must be verified in the Resend dashboard
RESEND_API_KEY=
RESEND_FROM_EMAIL=support@rackuppoints.com

# Canonical site origin (no trailing slash), e.g. https://app.example.com.
# Used to build invite / password-reset links; falls back to request headers.
NEXT_PUBLIC_SITE_URL=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Firebase Admin (server only)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
